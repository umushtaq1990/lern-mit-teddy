          ]
        },
        "en": {
          "audio_url": "/content/audio/lecture-26/part-3-en.mp3",
          "sentences": [
            {
              "text": "Ghani' means rich, and 'faqir' means poor.",
              "start": 0.1,
              "end": 3.5625
            },
            {
              "text": "Tabib' refers to a doctor.",
              "start": 3.5125,
              "end": 5.9375
            }
          ]
        }
      }
    },
    {
      "id": "part-4",
      "arabic_example": "إخوان / أخوات",
      "title": {
        "ur": "رشتوں کے جمع الفاظ",
        "en": "Plural words for relatives"
      },
      "question": {
        "ur": "'أخوات' کا کیا مطلب ہے؟",
        "en": "What does 'akhawat' mean?"
      },
      "narration": {
        "ur": {
          "audio_url": "/content/audio/lecture-26/part-4.mp3",
          "sentences": [
            {
              "text": "إخوان' کا مطلب ہے کئی بھائی",
              "start": 0.1,
              "end": 2.625
            },
            {
              "text": "أخوات' کا مطلب ہے کئی بہنیں",
              "start": 2.575,
              "end": 5.2125
            }
          ]
        },
        "en": {
          "audio_url": "/content/audio/lecture-26/part-4-en.mp3",
          "sentences": [
            {
              "text": "Ikhwan' means several brothers.",
              "start": 0.1,
              "end": 2.5875
            },
            {
              "text": "Akhawat' means several sisters.",
              "start": 2.5375,
              "end": 5.175
            }
          ]
        }
      }
    },
    {
      "id": "part-5",
      "arabic_example": "الشیخ",
      "title": {
        "ur": "لفظ 'شیخ' کے کئی معنی",
        "en": "The several meanings of the word 'shaykh'"
      },
      "question": {
        "ur": "'الشیخ' کن کن کے لیے استعمال ہو سکتا ہے؟",
        "en": "Who can the word 'al-shaykh' be used for?"
      },
      "narration": {
        "ur": {
          "audio_url": "/content/audio/lecture-26/part-5.mp3",
          "sentences": [
            {
              "text": "الشیخ' کا مطلب صرف 'استاد' نہیں ہے",
              "start": 0.1,
              "end": 3.225
            },
            {
              "text": "یہ کسی عالم، بزرگ، یا دولت مند شخص کے لیے بھی استعمال ہوتا ہے",
              "start": 3.175,
              "end": 7.7125
            }
          ]
        },
        "en": {
          "audio_url": "/content/audio/lecture-26/part-5-en.mp3",
          "sentences": [
            {
              "text": "Al-shaykh' does not only mean 'teacher'.",
              "start": 0.1,
              "end": 2.9125
            },
            {
              "text": "It is also used for a religious scholar, an elder, or a wealthy person.",
              "start": 2.8625,
              "end": 7.825
            }
          ]
        }
      }
    },
    {
      "id": "part-6",
      "arabic_example": "ممنوع من الصرف",
      "title": {
        "ur": "ممنوع من الصرف کی ایک قسم",
        "en": "A type of mamnu' min al-sarf"
      },
      "question": {
        "ur": "'ممنوع من الصرف' الفاظ کے آخر میں کیا نہیں آتا؟",
        "en": "What does not appear at the end of 'mamnu' min al-sarf' words?"
      },
      "narration": {
        "ur": {
          "audio_url": "/content/audio/lecture-26/part-6.mp3",
          "sentences": [
            {
              "text": "کچھ مؤنث نام اور خاص صفتیں تنوین قبول نہیں کرتیں",
              "start": 0.1,
              "end": 4.0625
            },
            {
              "text": "انہیں 'ممنوع من الصرف' کہا جاتا ہے",
              "start": 4.0125,
              "end": 7.075
            }
          ]
        },
        "en": {
          "audio_url": "/content/audio/lecture-26/part-6-en.mp3",
          "sentences": [
            {
              "text": "Some feminine names and certain adjectives do not take tanween.",
