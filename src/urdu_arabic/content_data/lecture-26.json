    "en": "Class 26 — Plural Formation Recap, Tanween Loss in Idafa, Professions/Family Vocabulary, Ash-Shaykh, Mamnu min al-Sarf"
  },
  "parts": [
    {
      "id": "part-1",
      "arabic_example": "رجل / رجال",
      "title": {
        "ur": "واحد سے جمع بنانا: رجل / رجال",
        "en": "Forming the plural from the singular: rajul / rijal"
      },
      "question": {
        "ur": "'رجال' کس لفظ کی جمع ہے؟",
        "en": "Which word is 'rijal' the plural of?"
      },
      "narration": {
        "ur": {
          "audio_url": "/content/audio/lecture-26/part-1.mp3",
          "sentences": [
            {
              "text": "رجل' کا مطلب ہے ایک آدمی، اور 'رجال' کا مطلب ہے کئی آدمی",
              "start": 0.1,
              "end": 4.75
            },
            {
              "text": "یہ ایک مثال ہے کہ واحد سے جمع کیس طرح بنتی ہے",
              "start": 4.7,
              "end": 8.475
            }
          ]
        },
        "en": {
          "audio_url": "/content/audio/lecture-26/part-1-en.mp3",
          "sentences": [
            {
              "text": "Rajul' means one man, and 'rijal' means several men.",
              "start": 0.1,
              "end": 4.025
            },
            {
              "text": "This is an example of how the plural is formed from the singular.",
              "start": 3.975,
              "end": 8.0375
            }
          ]
        }
      }
    },
    {
      "id": "part-2",
      "arabic_example": "اضافہ",
      "title": {
        "ur": "اضافہ میں تنوین کا ختم ہونا",
        "en": "The loss of tanween in idafa"
      },
      "question": {
        "ur": "اضافہ میں کیا چیز ختم ہو جاتی ہے؟",
        "en": "What is dropped in an idafa construction?"
      },
      "narration": {
        "ur": {
          "audio_url": "/content/audio/lecture-26/part-2.mp3",
          "sentences": [
            {
              "text": "جب کوئی اسم کسی دوسرے اسم کے ساتھ مل کر ملکیت ظاہر کرے تو اس کی تنوین ختم ہو جاتی ہے",
              "start": 0.1,
              "end": 6.3
            },
            {
              "text": "یہ قاعدہ 'اضافہ' کہلاتا ہے",
              "start": 6.25,
              "end": 9.05
            }
          ]
        },
        "en": {
          "audio_url": "/content/audio/lecture-26/part-2-en.mp3",
          "sentences": [
            {
              "text": "When a noun combines with another noun to express possession, its tanween is dropped.",
              "start": 0.1,
              "end": 5.325
            },
            {
              "text": "This rule is called 'idafa' (the possessive/genitive construction).",
              "start": 5.275,
              "end": 10.05
            }
          ]
        }
      }
    },
    {
      "id": "part-3",
      "arabic_example": "غنی / فقیر / طبیب",
      "title": {
        "ur": "پیشے اور حیثیت کے الفاظ",
        "en": "Words for professions and status"
      },
      "question": {
        "ur": "'فقیر' کا کیا مطلب ہے؟",
        "en": "What does 'faqir' mean?"
      },
      "narration": {
        "ur": {
          "audio_url": "/content/audio/lecture-26/part-3.mp3",
          "sentences": [
            {
              "text": "غنی' کا مطلب ہے امیر، اور 'فقیر' کا مطلب ہے غریب",
              "start": 0.1,
              "end": 4.35
            },
            {
              "text": "طبیب' ڈاکٹر کو کہتے ہیں",
