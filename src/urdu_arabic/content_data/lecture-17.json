{
  "id": "lecture-17",
  "title": {
    "ur": "کلاس 17 — عِند بمقابلہ مَع، صفت (نعت) کی موافقت کے اصول، صفات، تعلیمی درجے، الذي/التي، سمتیں",
    "en": "Class 17 — 'Inda vs Ma'a, Na'at Agreement Rules, Adjectives, Education Levels, Alladhi/Allati, Directions"
  },
  "parts": [
    {
      "id": "part-1",
      "arabic_example": "عند / مع",
      "title": {
        "ur": "عِند اور مَع میں فرق",
        "en": "The Difference Between 'Inda and Ma'a"
      },
      "question": {
        "ur": "'عند' اور 'مع' میں کیا فرق ہے؟",
        "en": "What is the difference between ''inda' and 'ma'a'?"
      },
      "narration": {
        "ur": {
          "audio_url": "/content/audio/lecture-17/part-1.mp3",
          "sentences": [
            {
              "text": "عند' کا مطلب ہے کسی کی جگہ پر یا پاس، جیسے 'عند المدير' یعنی 'پرنسیپل کے پاس'",
              "start": 0.1,
              "end": 5.95
            },
            {
              "text": "مع' کا مطلب ہے کسی کے ساتھ، جیسے 'مع المدير' یعنی 'پرنسیپل کے ساتھ'",
              "start": 5.9,
              "end": 11.0875
            }
          ]
        },
        "en": {
          "audio_url": "/content/audio/lecture-17/part-1-en.mp3",
          "sentences": [
            {
              "text": "Inda' means at someone's place or in their possession, as in ''inda al-mudir', meaning 'at the principal's' / 'with the principal'.",
              "start": 0.1,
              "end": 7.5625
            },
            {
              "text": "Ma'a' means together with someone, as in 'ma'a al-mudir', meaning 'with the principal'.",
              "start": 7.5125,
              "end": 13.0375
            }
          ]
        }
      }
    },
    {
      "id": "part-2",
      "arabic_example": "النعت",
      "title": {
        "ur": "صفت کی چار شرطیں",
        "en": "The Four Conditions of the Adjective (Na'at)"
      },
      "question": {
        "ur": "صفت کو اسم کے ساتھ کتنی چیزوں میں میل کھانا ضروری ہے؟",
        "en": "In how many things must the adjective agree with the noun?"
      },
      "narration": {
        "ur": {
          "audio_url": "/content/audio/lecture-17/part-2.mp3",
          "sentences": [
            {
              "text": "صفت کو اپنے اسم کے ساتھ چار چیزوں میں میل کھانا ضروری ہے",
              "start": 0.1,
              "end": 4.4
            },
            {
              "text": "پہلی: حالت یعنی رفع، نصب یا جر",
              "start": 4.35,
              "end": 7.5
            },
            {
              "text": "دوسری: جنس یعنی مذکر یا مؤنث",
              "start": 7.5,
              "end": 10.85
            },
            {
              "text": "تیسری: معرفہ یا نکرہ ہونا",
              "start": 10.85,
              "end": 13.8125
            },
            {
              "text": "چوتھی: واحد، تثنیہ یا جمع ہونا",
              "start": 13.8125,
              "end": 16.975
            }
          ]
        },
        "en": {
          "audio_url": "/content/audio/lecture-17/part-2-en.mp3",
          "sentences": [
            {
              "text": "The adjective (na'at) must agree with its noun in four things.",
              "start": 0.1,
              "end": 4.7125
            },
            {
              "text": "First: case — that is, raf', nasb, or jarr.",
              "start": 4.6625,
              "end": 9.2375
            },
            {
              "text": "Second: gender — that is, masculine or feminine.",
              "start": 9.2375,
              "end": 13.425
            },
            {
              "text": "Third: being definite or indefinite.",
              "start": 13.425,
              "end": 16.45
            },
            {
              "text": "Fourth: being singular, dual, or plural.",
              "start": 16.45,
              "end": 20.325
            }
          ]
        }
      }
    },
    {
      "id": "part-3",
      "arabic_example": "صغير، طويل، قصير",
      "title": {
        "ur": "صفات: چھوٹا، لمبا، چھوٹا قد",
        "en": "Adjectives: Small, Tall, Short"
      },
      "question": {
        "ur": "'صغير' کس لفظ کا الٹ ہے؟",
        "en": "Which word is 'saghir' the opposite of?"
      },
      "narration": {
        "ur": {
          "audio_url": "/content/audio/lecture-17/part-3.mp3",
          "sentences": [
            {
              "text": "صغير' چھوٹے کو کہتے ہیں، یہ 'كبير' یعنی بڑے کا الٹ ہے",
              "start": 0.1,
              "end": 4.375
            },
            {
              "text": "طويل' لمبے کو کہتے ہیں، اور 'قصير' چھوٹے قد کو",
              "start": 4.325,
              "end": 8.2375
            }
          ]
        },
        "en": {
          "audio_url": "/content/audio/lecture-17/part-3-en.mp3",
          "sentences": [
            {
              "text": "Saghir' means small; it is the opposite of 'kabir', meaning big.",
              "start": 0.1,
              "end": 4.6375
            },
            {
              "text": "Tawil' means tall, and 'qasir' means short (in height).",
              "start": 4.5875,
              "end": 8.6375
            }
          ]
        }
      }
    },
    {
      "id": "part-4",
      "arabic_example": "حاد، مقصور",
      "title": {
        "ur": "صفات: تیز، ٹوٹا ہوا",
        "en": "Adjectives: Sharp, Broken"
      },
      "question": {
        "ur": "'حاد' کس قسم کی چیز کے لیے استعمال ہوتا ہے؟",
        "en": "What kind of thing is 'hadd' used for?"
      },
      "narration": {
        "ur": {
          "audio_url": "/content/audio/lecture-17/part-4.mp3",
          "sentences": [
            {
              "text": "حاد' تیز دھار والی چیز کے لیے استعمال ہوتا ہے، جیسے چاقو",
              "start": 0.1,
              "end": 4.425
            },
            {
              "text": "مقصور' ٹوٹی ہوئی چیز کے لیے استعمال ہوتا ہے، جیسے 'السرير المقصور' یعنی 'ٹوٹا ہوا بستر'",
              "start": 4.375,
              "end": 10.9
            }
          ]
        },
        "en": {
          "audio_url": "/content/audio/lecture-17/part-4-en.mp3",
          "sentences": [
            {
              "text": "Hadd' is used for something sharp-edged, like a knife.",
              "start": 0.1,
              "end": 3.7875
            },
            {
              "text": "Maksur' is used for something broken, as in 'as-sarir al-maksur', meaning 'the broken bed'.",
              "start": 3.7375,
              "end": 9.875
            }
          ]
        }
      }
    },
    {
      "id": "part-5",
      "arabic_example": "الابتدائية، المتوسطة، الثانوية",
      "title": {
        "ur": "تعلیمی درجے: پرائمری، مڈل، ہائی سکول",
        "en": "Education Levels: Primary, Middle, High School"
      },
      "question": {
        "ur": "'الثانوية' کس تعلیمی درجے کو کہتے ہیں؟",
        "en": "Which education level is called 'ath-thanawiyya'?"
      },
      "narration": {
        "ur": {
          "audio_url": "/content/audio/lecture-17/part-5.mp3",
          "sentences": [
            {
              "text": "الابتدائية' پرائمری سکول کو کہتے ہیں",
              "start": 0.1,
              "end": 3.125
            },
            {
              "text": "المتوسطة' مڈل سکول کو کہتے ہیں، اور 'الثانوية' ہائی سکول کو",
              "start": 3.075,
              "end": 7.7125
            }
          ]
        },
        "en": {
          "audio_url": "/content/audio/lecture-17/part-5-en.mp3",
          "sentences": [
            {
              "text": "Al-ibtida'iyya' means primary school.",
              "start": 0.1,
              "end": 2.9875
            },
            {
              "text": "Al-mutawassita' means middle school, and 'ath-thanawiyya' means high school.",
              "start": 2.9375,
              "end": 7.9625
            }
          ]
        }
      }
    },
    {
      "id": "part-6",
      "arabic_example": "الذي / التي",
      "title": {
        "ur": "موصولہ الفاظ: الذي، التي",
        "en": "Relative Pronouns: alladhi, allati"
      },
      "question": {
        "ur": "مؤنث اسم کے لیے کون سا موصولہ لفظ استعمال ہوتا ہے؟",
        "en": "Which relative pronoun is used for a feminine noun?"
      },
      "narration": {
        "ur": {
          "audio_url": "/content/audio/lecture-17/part-6.mp3",
          "sentences": [
            {
              "text": "مذکر اسم کے لیے 'الذي' استعمال ہوتا ہے، اور مؤنث اسم کے لیے 'التي'",
              "start": 0.1,
              "end": 5.2875
            },
            {
              "text": "دونوں کا مطلب ہے 'جو'، یعنی کسی چیز کی مزید وضاحت دینے کے لیے",
              "start": 5.2375,
              "end": 10.45
            }
          ]
        },
        "en": {
          "audio_url": "/content/audio/lecture-17/part-6-en.mp3",
          "sentences": [
            {
              "text": "Alladhi' is used for a masculine noun, and 'allati' is used for a feminine noun.",
              "start": 0.1,
              "end": 5.2
            },
            {
              "text": "Both mean 'who/which', used to give further description of something.",
              "start": 5.15,
              "end": 9.7375
            }
          ]
        }
      }
    },
    {
      "id": "part-7",
      "arabic_example": "خلف، فوق، تحت",
      "title": {
        "ur": "سمت بتانے والے الفاظ: پیچھے، اوپر، نیچے",
        "en": "Direction Words: Behind, Above, Below"
      },
      "question": {
        "ur": "'فوق' کا کیا مطلب ہے؟",
        "en": "What does 'fawq' mean?"
      },
      "narration": {
        "ur": {
          "audio_url": "/content/audio/lecture-17/part-7.mp3",
          "sentences": [
            {
              "text": "خلف' پیچھے کے لیے استعمال ہوتا ہے",
              "start": 0.1,
              "end": 3.0875
            },
            {
              "text": "فوق' اوپر کے لیے، اور 'تحت' نیچے کے لیے استعمال ہوتا ہے",
              "start": 3.0375,
              "end": 7.2125
            }
          ]
        },
        "en": {
          "audio_url": "/content/audio/lecture-17/part-7-en.mp3",
          "sentences": [
            {
              "text": "Khalf' is used for 'behind'.",
              "start": 0.1,
              "end": 2.475
            },
            {
              "text": "Fawq' is used for 'above', and 'taht' is used for 'below'.",
              "start": 2.425,
              "end": 6.525
            }
          ]
        }
      }
    }
  ]
}