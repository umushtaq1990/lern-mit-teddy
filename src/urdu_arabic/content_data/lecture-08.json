      },
      "narration": {
        "ur": {
          "audio_url": "/content/audio/lecture-08/part-7.mp3",
          "sentences": [
            {
              "text": "اليابان' جاپان کو کہتے ہیں، اور 'الهند' انڈیا کو",
              "start": 0.1,
              "end": 4.2125
            },
            {
              "text": "السعودية' سعودی عرب کو کہتے ہیں",
              "start": 4.1625,
              "end": 7.075
            },
            {
              "text": "الصين' چین کو، اور 'الفلبين' فلپائن کو کہتے ہیں",
              "start": 7.075,
