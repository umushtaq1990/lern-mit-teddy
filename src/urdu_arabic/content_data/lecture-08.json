            }
          ]
        },
        "en": {
          "audio_url": "/content/audio/lecture-08/part-7-en.mp3",
          "sentences": [
            {
              "text": "means Japan, and 'الهند' means India.",
              "start": 0.1,
              "end": 2.9875
            },
            {
              "text": "means Saudi Arabia.",
              "start": 2.9375,
              "end": 5.0875
            },
            {
              "text": "means China, and 'الفلبين' means the Philippines.",
              "start": 5.0875,
              "end": 8.3125
            }
          ]
        }
      }
    },
    {
      "id": "part-8",
      "arabic_example": "المدير، التاجر",
      "title": {
        "ur": "پیشوں کے نام: المدير، التاجر",
