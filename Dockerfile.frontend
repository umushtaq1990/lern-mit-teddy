FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg && rm -rf /var/lib/apt/lists/*

# Pinned to the same uv version the committed uv.lock was generated with, so
# `--frozen` installs reproduce it exactly instead of `pip install .` silently
# re-resolving to whatever versions happen to be newest on build day.
RUN pip install --no-cache-dir uv==0.11.6

COPY pyproject.toml uv.lock README.md ./
COPY src ./src

RUN uv sync --frozen --no-editable

ENV PATH="/app/.venv/bin:$PATH"

EXPOSE 8080

ENV FRONTEND_HOST=0.0.0.0 \
    FRONTEND_PORT=8080 \
    FRONTEND_RELOAD=false

CMD ["python", "-m", "src.frontend"]
