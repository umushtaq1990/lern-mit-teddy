{
  "title": "Teddy Overview",
  "uid": "teddy-overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-7d", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Sessions per day",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "postgres", "uid": "postgres-teddy" },
      "targets": [
        {
          "rawSql": "SELECT date_trunc('day', started_at) AS time, count(*) AS sessions FROM sessions WHERE started_at IS NOT NULL GROUP BY 1 ORDER BY 1",
          "format": "time_series"
        }
      ]
    },
    {
      "id": 2,
      "title": "Sessions by language",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "postgres", "uid": "postgres-teddy" },
      "targets": [
        {
          "rawSql": "SELECT coalesce(language, 'unknown') AS language, count(*) AS sessions FROM sessions GROUP BY 1 ORDER BY 2 DESC",
          "format": "table"
        }
      ]
    },
    {
      "id": 3,
      "title": "Active users",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 8 },
      "datasource": { "type": "postgres", "uid": "postgres-teddy" },
      "targets": [
        {
          "rawSql": "SELECT count(DISTINCT user_id) AS value FROM sessions WHERE user_id IS NOT NULL",
          "format": "table"
        }
      ]
    },
    {
      "id": 4,
      "title": "Estimated cost per day (USD)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 18, "x": 6, "y": 8 },
      "datasource": { "type": "postgres", "uid": "postgres-teddy" },
      "description": "Populated by the Langfuse export enrichment job, not at session-start time — empty until that job has run.",
      "targets": [
        {
          "rawSql": "SELECT date_trunc('day', started_at) AS time, sum(estimated_cost_usd) AS cost_usd FROM sessions WHERE estimated_cost_usd IS NOT NULL GROUP BY 1 ORDER BY 1",
          "format": "time_series"
        }
      ]
    },
    {
      "id": 5,
      "title": "Request latency (p50 / p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 6,
      "title": "Requests/sec and error rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[5m]))",
          "legendFormat": "requests/sec"
        },
        {
          "expr": "sum(rate(http_requests_total{status=~\"5..\"}[5m]))",
          "legendFormat": "5xx/sec"
        }
      ]
    }
  ]
}
