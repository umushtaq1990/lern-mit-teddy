FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update \
    ; apt-get install -y --no-install-recommends ffmpeg \
    ; rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md ./
COPY src ./src

RUN pip install --no-cache-dir .

# Download the VAD model during image build to reduce cold starts.
RUN python -m src.livekit.agent download-files

CMD ["python", "-m", "src.livekit.agent", "start"]
