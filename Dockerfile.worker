FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# git is needed for uv to install the ai-platform-shared dependency from GitHub.
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg git && rm -rf /var/lib/apt/lists/*

# Pinned to the same uv version the committed uv.lock was generated with, so
# `--frozen` installs reproduce it exactly instead of `pip install .` silently
# re-resolving to whatever versions happen to be newest on build day.
RUN pip install --no-cache-dir uv==0.11.6

COPY pyproject.toml uv.lock README.md ./
COPY src ./src

RUN uv sync --frozen --no-editable

ENV PATH="/app/.venv/bin:$PATH"

# Download the VAD model during image build to reduce cold starts.
# OPENAI_API_KEY here is a build-time-only placeholder: importing src.livekit.agent
# transitively imports src/langgraph/agent.py, which constructs ChatOpenAI(...) at
# module load time — its constructor validates that *some* key string is present,
# even though no API call is actually made by "download-files". Without this, the
# build fails in any CI/CD environment that (correctly) has no secrets at build time.
RUN OPENAI_API_KEY=build-time-placeholder-not-a-real-key python -m src.livekit.agent download-files

CMD ["python", "-m", "src.livekit.agent", "start"]
