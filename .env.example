# ── LiveKit ────────────────────────────────────────────────────────────────────
# Get these from https://cloud.livekit.io (free tier available)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# ── OpenAI ─────────────────────────────────────────────────────────────────────
# Required — used for LLM and TTS
OPENAI_API_KEY=your_openai_api_key

# ── Language & Voice Mode ──────────────────────────────────────────────────────
# Language Teddy teaches (de=German, en=English, ar=Arabic, hi=Hindi)
LANGUAGE=de

# Voice pipeline mode: "pipeline" (recommended) or "openai_realtime"
VOICE_MODE=pipeline

# LLM model — gpt-4o-mini gives best language compliance; gpt-4.1-nano is cheaper
LLM_MODEL=gpt-4o-mini

# ── STT (Speech-to-Text) ───────────────────────────────────────────────────────
# "faster_whisper" = local, free  |  "deepgram" = cloud, faster
STT_PROVIDER=faster_whisper
STT_MODEL=base

# Deepgram (only needed if STT_PROVIDER=deepgram)
# DEEPGRAM_API_KEY=your_deepgram_api_key

# ── TTS (Text-to-Speech) ───────────────────────────────────────────────────────
# "openai" = OpenAI TTS (recommended)  |  "edge_tts" = free Microsoft TTS
# |  "hume" = Hume AI (expressive, requires HUME_* keys below)
TTS_PROVIDER=openai
TTS_MODEL=tts-1-hd
TTS_VOICE=nova

# Optional: Kokoro local TTS server (OpenAI-compatible, runs offline)
# TTS_BASE_URL=http://localhost:8880/v1
# TTS_API_KEY=not-needed

# ── Hume AI TTS (only needed if TTS_PROVIDER=hume) ────────────────────────────
# HUME_API_KEY=your_hume_api_key
# HUME_SECRET_KEY=your_hume_secret_key
# HUME_CONFIG_ID=your_hume_config_id

# ── OpenAI Realtime (only needed if VOICE_MODE=openai_realtime) ───────────────
# OPENAI_REALTIME_MODEL=gpt-4o-mini-realtime-preview
# OPENAI_REALTIME_VOICE=alloy

# ── Langfuse Tracing (optional — leave blank to disable) ──────────────────────
# Sign up at https://cloud.langfuse.com (free tier available)
# LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
# LANGFUSE_SECRET_KEY=your_langfuse_secret_key
# LANGFUSE_HOST=https://cloud.langfuse.com

# ── Frontend ───────────────────────────────────────────────────────────────────
FRONTEND_PORT=8080
# FRONTEND_HOST=127.0.0.1
