# ── LiveKit ────────────────────────────────────────────────────────────────────
# Get these from https://cloud.livekit.io (free tier available)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# ── OpenAI ─────────────────────────────────────────────────────────────────────
# Required — used for LLM and TTS
OPENAI_API_KEY=your_openai_api_key

# ── Language & Voice Mode ──────────────────────────────────────────────────────
# Language Teddy teaches (de=German, en=English, ar=Arabic, hi=Hindi)
LANGUAGE=de

# Voice pipeline mode: "pipeline" (recommended) or "openai_realtime"
VOICE_MODE=pipeline

# LLM model — gpt-4o-mini gives best language compliance; gpt-4.1-nano is cheaper
LLM_MODEL=gpt-4o-mini

# ── STT (Speech-to-Text) ───────────────────────────────────────────────────────
# "faster_whisper" = local, free  |  "deepgram" = cloud, faster
STT_PROVIDER=faster_whisper
STT_MODEL=base

# Deepgram (only needed if STT_PROVIDER=deepgram)
# DEEPGRAM_API_KEY=your_deepgram_api_key

# ── TTS (Text-to-Speech) ───────────────────────────────────────────────────────
# "openai" = OpenAI TTS (recommended)  |  "edge_tts" = free Microsoft TTS
# |  "hume" = Hume AI (expressive, requires HUME_* keys below)
TTS_PROVIDER=openai
TTS_MODEL=tts-1-hd
TTS_VOICE=nova

# Optional: Kokoro local TTS server (OpenAI-compatible, runs offline)
# TTS_BASE_URL=http://localhost:8880/v1
# TTS_API_KEY=not-needed

# ── Hume AI TTS (only needed if TTS_PROVIDER=hume) ────────────────────────────
# HUME_API_KEY=your_hume_api_key
# HUME_SECRET_KEY=your_hume_secret_key
# HUME_CONFIG_ID=your_hume_config_id

# ── OpenAI Realtime (only needed if VOICE_MODE=openai_realtime) ───────────────
# OPENAI_REALTIME_MODEL=gpt-4o-mini-realtime-preview
# OPENAI_REALTIME_VOICE=alloy

# ── Langfuse Tracing (optional — leave blank to disable) ──────────────────────
# Sign up at https://cloud.langfuse.com (free tier available)
# LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
# LANGFUSE_SECRET_KEY=your_langfuse_secret_key
# LANGFUSE_HOST=https://cloud.langfuse.com

# ── Frontend ───────────────────────────────────────────────────────────────────
FRONTEND_PORT=8080
# FRONTEND_HOST=127.0.0.1
# FRONTEND_URL=http://127.0.0.1:8080
# LIVEKIT_AGENT_NAME=

# ── Login (Microsoft Entra External ID / CIAM) — optional, login is otherwise
# unavailable and /api/me reports login_available=false ───────────────────────
# AUTH_TENANT_ID=your_ciam_tenant_id
# AUTH_DOMAIN=your_ciam_subdomain
# AUTH_CLIENT_ID=your_app_registration_client_id
# AUTH_CLIENT_SECRET=your_app_registration_client_secret
# AUTH_SESSION_SECRET=change-me-to-a-random-string
# SESSION_COOKIE_SECURE=true

# ── Local database (docker-compose local stack) ───────────────────────────────
# Default below uses a local SQLite file when unset. docker-compose.yml sets
# DATABASE_URL itself for the frontend/worker/migrate containers — these two
# are only needed if you run the app directly on your host against the
# dockerized Postgres (e.g. `docker compose up db` then run frontend locally).
# DATABASE_URL=postgresql+psycopg://teddy:teddy_dev_password@localhost:5433/teddy
# POSTGRES_USER=teddy
# POSTGRES_PASSWORD=teddy_dev_password
# POSTGRES_DB=teddy

# ── Grafana (docker-compose local stack) ──────────────────────────────────────
# GRAFANA_ADMIN_PASSWORD=admin

# ── MLflow (prompt/judge evaluation tracking — see src/langgraph/eval) ───────
# MLFLOW_TRACKING_URI=sqlite:///./mlflow.db

# ── Urdu/Arabic learning app (new, isolated module: src/urdu_arabic) ─────────
# Separate session secret from AUTH_SESSION_SECRET above — isolated login.
# URDU_ARABIC_SESSION_SECRET=change-me-to-a-random-string
# URDU_ARABIC_OTP_TTL_SECONDS=300
# URDU_ARABIC_HOST=127.0.0.1
# URDU_ARABIC_PORT=8090
#
# OTP delivery (src/urdu_arabic/otp_delivery.py) — leaving these unset just
# logs the code instead of sending it, so local dev needs none of this.
# Email (Gmail SMTP, needs 2-Step Verification + an App Password, not your
# normal password — myaccount.google.com/apppasswords):
# URDU_ARABIC_SMTP_USER=you@gmail.com
# URDU_ARABIC_SMTP_APP_PASSWORD=<16-char app password>
# URDU_ARABIC_OTP_EMAIL_FROM_NAME=Lisan
# WhatsApp (Twilio — console.twilio.com for the SID/token; the default FROM
# below is Twilio's shared testing sandbox number):
# URDU_ARABIC_TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# URDU_ARABIC_TWILIO_AUTH_TOKEN=your-twilio-auth-token
# URDU_ARABIC_TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── Local LLM (Ollama) — used by src/urdu_arabic's worker, same pattern as
# the JME reference architecture: a local Ollama server, no OpenAI spend.
# Run `ollama pull qwen2.5:3b` once, then `ollama serve` (or just run a query —
# it auto-starts on most installs) before running the urdu_arabic worker.
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:3b
# OLLAMA_TIMEOUT_SECONDS=60

# ── Cloud export job only (pipelines/langfuse_export) — NOT read by the live
# app; this job is a standalone Azure Container Apps Job, see its own README ──
# SQL_SERVER=your-sql-server.database.windows.net
# SQL_DATABASE=your_database
# SQL_USER=your_sql_user
# SQL_PASSWORD=your_sql_password
# STORAGE_CONNECTION_STRING=your_azure_storage_connection_string
# STORAGE_CONTAINER=transcripts
